# Copy to .env and adjust for local development.
# Placeholders only — never commit real secrets.

# Postgres
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio
DATABASE_URL=postgresql://studio:studio@postgres:5432/studio

# Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=studio-dev
TEMPORAL_TASK_QUEUE=studio-default

# MinIO (compose stand-in for GCS)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=studio-dev

# Vault (compose stand-in for GCP Secret Manager)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token

# API
API_HOST=0.0.0.0
API_PORT=8080
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Samy identity bootstrap placeholders (M1+)
STUDIO_ORG_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
SESSION_SECRET=
STUDIO_COOKIE_SECURE=false
INVITE_TTL_HOURS=72
STUDIO_EMAIL_ADAPTER=log

# Ping worker lifecycle (used by make ping-stop / ping-start)
PING_WORKER_STOP_CMD=docker compose -f infra/compose/docker-compose.yml -p agent-studio stop studio-worker-ping
PING_WORKER_START_CMD=docker compose -f infra/compose/docker-compose.yml -p agent-studio start studio-worker-ping
